{
  "name": "electron-onduty",
  "version": "1.0.0",
  "description": "OnDuty System Web App",
  "main": "index.html",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:server": "cd server && npm run dev",
    "build": "npm run typecheck && vite build && cd server && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.13.4",
    "better-sqlite3": "^12.5.0",
    "element-plus": "^2.13.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.12",
    "patch-package": "^8.0.1",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/nodemailer": "^7.0.4",
    "@vitejs/plugin-vue": "^6.0.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vue": "^3.5.25",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.6"
  }
}
